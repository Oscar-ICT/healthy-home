#pragma once
//
// Copy this file to `src/config.h` and fill in your own values.
// `src/config.h` is gitignored so keys never get committed.
//

// ---- WiFi -------------------------------------------------------------
// Wokwi simulator: SSID "Wokwi-GUEST", empty password, channel 6.
#define WIFI_SSID       "Wokwi-GUEST"
#define WIFI_PASSWORD   ""

// ---- ThingSpeak: Telemetry channel (device writes) ------------------
// From the channel's "API Keys" tab.
#define TS_TELEMETRY_CHANNEL_ID   0
#define TS_TELEMETRY_WRITE_KEY    "XXXXXXXXXXXXXXXX"

// ---- ThingSpeak: Control channel (device reads) --------------------
#define TS_CONTROL_CHANNEL_ID     0
#define TS_CONTROL_READ_KEY       "XXXXXXXXXXXXXXXX"

// ---- Cadence --------------------------------------------------------
// ThingSpeak free tier allows one write per 15 s per channel.
#define TS_UPLOAD_INTERVAL_MS   20000UL
#define TS_POLL_INTERVAL_MS     20000UL
