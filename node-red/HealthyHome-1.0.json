    {
        "id": "3fa10b1a92b266a7",
        "type": "function",
        "z": "b17a4b2254ba0ffe",
        "name": "Clamp servo angle",
        "func": "let angle = Number(msg.payload);\nif (Number.isNaN(angle)) {\n    node.warn(`Invalid servo angle: ${msg.payload}`);\n    return null;\n}\nangle = Math.max(0, Math.min(180, Math.round(angle)));\nmsg.payload = angle;\nmsg.topic = \"week6/HealthyHome/actuator/servo/set\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
